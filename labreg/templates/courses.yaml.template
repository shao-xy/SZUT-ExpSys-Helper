# 排课计划
#
# 本文件是「教师定制排课的唯一入口」。
# 每个字段都可用注释说明含义，示例如下。
#
# ---------------------------------------------------------------
# 一门课程
# ---------------------------------------------------------------
courses:
  - name: 示例课程                    # 课程名称，用于显示与匹配
    course_code: "00000000"           # 课程代码，站点上的唯一标识

    # 一个课程下可以有多个教学班，各自的上课时间与地点可以不同
    classes:
      - name: 示例课程-0001A           # 课序号（站点上的班级名），必须与站点完全一致
        course_code: "00000000"       # 可省略，默认继承课程级
        weekday: 星期四               # 星期
        start_period: 3               # 起始节次
        end_period: 4                 # 结束节次
        room: N0000                   # 机房号；留空则由 Agent 询问
        batches: 1                    # 学生分批数，1 = 整班同时发下
        experiments:                  # 该班级下的各实验
          - project: 实验项目一         # 实验项目名关键字，用于在站点任务表中匹配
            weeks: [1, 3]             # [起始周, 结束周]，每周排课

          - project: 实验项目二
            weeks: [4, 7]

          # 单个实验可以覆盖班级的默认时间与地点
          - project: 实验项目三
            weeks: [8, 11]
            weekday: 星期四
            start_period: 3
            end_period: 4
            room: N0000

# ---------------------------------------------------------------
# 字段速查
# ---------------------------------------------------------------
# name            必填。课程名 / 班级名 / 实验项目名关键字
# course_code     课程代码，如 00000000
# weekday         星期一 ~ 星期日
# start_period    1 ~ 12
# end_period      1 ~ 12
# room            机房号，如 N0000
# batches         学生分批数，默认 1
# weeks           [起始周, 结束周]，1 ~ 24；每周排课，不分单双周
#
# 说明：站点对「每周」与「单周/双周」是两种排法。本工具只做每周排课，
#       留空 ddldsz 即表示每周，不会出现隔周上课。
